# Copy this file to android/keystore.properties and fill in your release keystore details.
# Generate a keystore with:
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore android/app/spinme-release.keystore \
#     -alias spinme -keyalg RSA -keysize 2048 -validity 10000
#
# Paths are relative to android/app/

storeFile=spinme-release.keystore
storePassword=your-store-password
keyAlias=spinme
keyPassword=your-key-password
